# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit it.

# ─── MQTT ─────────────────────────────────────────────────────
# Use your own broker (e.g. Mosquitto on the Jetson) — NOT a public one.
MQTT_BROKER=192.168.1.10
MQTT_TLS=true
# MQTT_PORT=8883              # default: 8883 with TLS, 1883 without
# MQTT_CA_CERT=/etc/mosquitto/certs/ca.crt   # leave out to use system CAs
MQTT_USERNAME=edgewatch
MQTT_PASSWORD=change-me
MQTT_TOPIC_SENSOR=wired/rms/#
MQTT_TOPIC_CONTROL=wired/control

# ─── Machine STOP / RUN ───────────────────────────────────────
SHUTDOWN_ENABLED=true
SHUTDOWN_RESEND_S=60          # re-send STOP every N s while still critical
AUTO_RESUME=false             # true = send RUN automatically after recovery
RESUME_HOLD_S=120             # ...but only after N s of continuous normal status
# Token for POST /api/control/resume (header X-Control-Token). Empty = manual resume disabled.
CONTROL_TOKEN=

# ─── Sensor / simulator ───────────────────────────────────────
EDGEWATCH_SENSOR_TIMEOUT=30   # alert when no real reading for N s
EDGEWATCH_SIM=auto            # auto | fallback | always | off
EDGEWATCH_SIM_SCENARIO=demo   # demo | normal

# ─── Storage ──────────────────────────────────────────────────
# EDGEWATCH_DB=/home/jetiot/edgewatch/edgewatch.db   # default: backend/edgewatch.db
EDGEWATCH_RETENTION_DAYS=365  # delete readings older than this (0 = keep forever)
